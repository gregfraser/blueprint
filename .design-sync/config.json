{
    "projectId": "cf65c2ec-7710-49b7-b078-521dae37a042",
    "shape": "storybook",
    "pkg": "@blueprintjs/core",
    "globalName": "Blueprint",
    "storybookConfigDir": ".storybook",
    "storybookStatic": ".design-sync/sb-reference",
    "buildCmd": "COREPACK_ENABLE_STRICT=0 pnpm exec nx run-many -t compile -p @blueprintjs/core @blueprintjs/icons @blueprintjs/datetime @blueprintjs/labs @blueprintjs/select @blueprintjs/table",
    "cssEntry": "lib/css/blueprint.css",
    "tsconfig": "../../.design-sync/preview-tsconfig.json",
    "provider": {
        "component": "BlueprintProvider"
    },
    "titleMap": {
        "IconGallery": null,
        "NextIconGallery": null,
        "Skeleton": null
    },
    "overrides": {
        "ProgressBar": {
            "cardMode": "column"
        },
        "Section": {
            "cardMode": "column"
        },
        "Slider": {
            "cardMode": "column"
        },
        "Spinner": {
            "cardMode": "column"
        },
        "Tabs": {
            "cardMode": "column"
        },
        "Tree": {
            "cardMode": "column"
        },
        "ControlGroup": {
            "cardMode": "column"
        },
        "FormGroup": {
            "cardMode": "column"
        },
        "HTMLSelect": {
            "cardMode": "column"
        },
        "Label": {
            "cardMode": "column"
        },
        "KeyComboTag": {
            "cardMode": "column"
        },
        "FileInput": {
            "cardMode": "column"
        },
        "InputGroup": {
            "cardMode": "column"
        },
        "NumericInput": {
            "cardMode": "column"
        },
        "TagInput": {
            "cardMode": "column"
        },
        "Overlay2": {
            "cardMode": "column"
        },
        "Toast": {
            "cardMode": "column"
        },
        "CompoundTag": {
            "cardMode": "column"
        },
        "Tag": {
            "cardMode": "column"
        },
        "Dialog": {
            "cardMode": "single",
            "primaryStory": "Default"
        },
        "Drawer": {
            "cardMode": "single",
            "primaryStory": "Default"
